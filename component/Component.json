{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Component",
  "type": "object",
  "required": [
    "component",
    "schema_version"
  ],
  "properties": {
    "component": {
      "type": "object",
      "required": [
        "name",
        "type",
        "owner"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 63,
          "title": "Component name"
        },
        "type": {
          "type": "string",
          "enum": [
            "api",
            "worker",
            "cron"
          ],
          "title": "Component type"
        },
        "owner": {
          "type": "string",
          "pattern": "^team-[a-z0-9-]+$",
          "title": "Owning team"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "title": "Description"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "schema_version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    }
  }
}
