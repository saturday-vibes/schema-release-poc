{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Component",
  "type": "object",
  "required": [
    "component",
    "schema_version"
  ],
  "properties": {
    "component": {
      "type": "object",
      "required": [
        "name",
        "type",
        "owner"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 63
        },
        "type": {
          "type": "string",
          "enum": [
            "api",
            "worker"
          ]
        },
        "owner": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "schema_version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    }
  }
}
