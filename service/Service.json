{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service",
  "type": "object",
  "required": [
    "service",
    "schema_version"
  ],
  "properties": {
    "service": {
      "type": "object",
      "required": [
        "name",
        "team"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "team": {
          "type": "string"
        },
        "tier": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        },
        "slack_channel": {
          "type": "string",
          "pattern": "^#[a-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    },
    "schema_version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    }
  }
}
